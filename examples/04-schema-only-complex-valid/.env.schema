version = 1

[variables.APP_NAME]
type = "string"
required = true
min_length = 3
max_length = 64

[variables.APP_ENV]
type = "string"
required = true
allowed = ["development", "staging", "production"]

[variables.APP_PORT]
type = "integer"
required = true
min = 1
max = 65535

[variables.DEBUG]
type = "boolean"
required = false

[variables.REQUEST_TIMEOUT]
type = "float"
required = false
min = 0.1
max = 60.0

[variables.API_KEY]
type = "string"
required = true
min_length = 32

[variables.HOST]
type = "string"
required = true
pattern = "^[a-zA-Z0-9.-]+$"

[variables.OPTIONAL_NOTE]
type = "string"
required = false
allow_empty = true
min_length = 10
pattern = "^nonempty"

[variables.LITERAL]
type = "string"
required = true

[variables.REGION]
type = "string"
required = true
allowed = ["us-east-1", "us-west-2", "sa-east-1"]
