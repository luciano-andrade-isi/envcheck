version = 1

[variables.APP_NAME]
type = "string"
required = true
min_length = 3

[variables.APP_ENV]
type = "string"
required = true
allowed = ["development", "staging", "production"]

[variables.APP_PORT]
type = "integer"
required = true
min = 1
max = 65535

[variables.DEBUG]
type = "boolean"
required = true

[variables.REQUEST_TIMEOUT]
type = "float"
required = true
min = 0.1
max = 60.0

[variables.API_KEY]
type = "string"
required = true
min_length = 32

[variables.HOST]
type = "string"
required = true
pattern = "^[a-zA-Z0-9.-]+$"
